# Copy to .env and fill in for LIVE read-only mode. Mock mode needs none of these.

# --- Kalshi (market data + trading) ---
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# Confirm both against https://docs.kalshi.com before trusting these defaults:
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_DEMO_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# --- Sportsbook odds (The Odds API: https://the-odds-api.com) ---
ODDS_API_KEY=

# --- Risk / bankroll (sub-$1k defaults) ---
PE_BANKROLL=500
PE_KELLY_FRACTION=0.25
PE_PER_MARKET_MAX_FRACTION=0.05
PE_MIN_EDGE=0.03
PE_MAX_CONTRACTS=200

# --- Fees / de-vig ---
PE_FEE_MULTIPLIER=0.07
PE_ASSUME_MAKER=1
PE_DEVIG_METHOD=multiplicative

# --- Market matching (auto-discover Kalshi sports markets and pair to sportsbooks) ---
PE_DYNAMIC_DISCOVERY=0        # 1 to auto-discover; 0 uses the static link registry
PE_SPORTS_SERIES=KXNBAGAME,KXNFLGAME,KXMLBGAME,KXNHLGAME,KXEPLGAME
PE_ODDS_SPORTS=americanfootball_nfl,baseball_mlb,icehockey_nhl,basketball_nba,soccer_epl
PE_MAX_SCAN_MARKETS=60       # cap discovered markets per scan (bounds API calls)

# --- Crypto statistical edge (lognormal spot+vol; free Coinbase data, no Odds API) ---
PE_CRYPTO_ENABLED=1
PE_CRYPTO_SERIES=KXBTCD,KXETHD,KXSOLD,KXXRPD   # short-term daily point-price series
PE_CRYPTO_MAX_DAYS=10        # skip long-dated markets (no edge a week+ out)
PE_CRYPTO_MIN_HOURS=1        # skip near-instant markets (model unreliable)

# --- Whale signal (keep WEIGHT 0 until validated out-of-sample) ---
PE_WHALE_WEIGHT=0.0
PE_WHALE_SOURCE=none          # none | polymarket
# JSON map { "KALSHI_TICKER": "polymarket_condition_id" } (0x + 64 hex, NOT a slug).
# Resolve a slug -> condition_id via gamma-api.polymarket.com/markets?slug=...
PE_WHALE_MAP=data/whale_map.json
PE_WHALE_MIN_RESOLVED=30      # min resolved markets for a wallet to count as "smart"
PE_WHALE_MIN_PNL=5000         # min realised PnL for a "smart" wallet
PE_WHALE_MAX_WALLETS=50
PE_WHALE_ENRICH=1             # fetch per-wallet win-rate/sample (stronger filter)
# Whale-as-PRIMARY signal for politics/econ/news markets (no sportsbook to de-vig):
PE_WHALE_PRIMARY=1
PE_WHALE_PRIMARY_MIN_CONF=0.30   # min smart-money confidence to act on as fair value

# --- OMEN SIGNAL BOARD (manual placement) ---
# 1 = advisory mode: the board ranks trades, YOU place them by hand on Omen.
# Omen prohibits API access, bots, browser automation and signal-following services,
# so this makes LiveExecutor refuse to construct - no code path reaches an order.
PE_RESEARCH_ONLY=1
PE_OMEN_ACCOUNT_SIZE=100000      # drives Omen's caps: 19 contracts/market, 38/event per $1k
PE_OMEN_PER_TRADE_FRACTION=0.01  # our own risk budget per idea (not an Omen rule)
PE_BOARD_MIN_HOURS=3             # allow same-day pre-game bets; in-play is blocked separately
PE_BOARD_MAX_DAYS=30             # and skip the far future - no edge a year out
PE_BOARD_MAX_DRIFT_C=4           # max cents price may run past the whale's entry
PE_BOARD_MIN_CONVICTION=0.35
PE_BOARD_MAX_TICKETS=8
# Staleness scales with each market's horizon (20% of time-to-resolution),
# floored at MIN and capped at CAP - a flat cut is wrong for slow markets.
PE_BOARD_MAX_SIGNAL_AGE_MIN=120
PE_BOARD_STALE_FRACTION=0.20
PE_BOARD_MAX_SIGNAL_AGE_CAP_MIN=2880
PE_JOURNAL_PATH=data/manual_journal.jsonl

# --- AUTONOMOUS OPERATION / SAFETY ---
# Master switch. 0 = dry-run (records paper trades only). 1 = place REAL orders.
# Ignored while PE_RESEARCH_ONLY=1.
PE_LIVE_TRADING=0
# When live, hit Kalshi's DEMO env first. 1 = demo, 0 = production.
PE_USE_DEMO=1
# Block production until a clean demo run has been recorded.
PE_REQUIRE_DEMO_FIRST=1
# Account circuit breakers (the bot runs unattended - these are the brakes):
PE_MAX_DAILY_LOSS=25
PE_MAX_TOTAL_EXPOSURE=200
PE_MAX_OPEN_POSITIONS=8
PE_MAX_ORDERS_PER_CYCLE=3
PE_SANE_EDGE_CEILING=0.25
PE_MIN_PRICE=0.05
PE_MAX_PRICE=0.95
# Order review / arbitrage hedging:
PE_ARB_ENABLED=1
PE_ARB_MIN_RATIO=0.02
PE_STALE_CANCEL_BAND=0.08
# Operational:
PE_POLL_INTERVAL=300
PE_KILLSWITCH=data/STOP
PE_STATE_DB=data/state.db
PE_LOG_PATH=data/predictionedge.log
PE_HEARTBEAT=data/heartbeat.json

# --- Paper ledger ---
PE_PAPER_LEDGER=data/paper_ledger.jsonl

# --- LIP maker bot (predictionedge/maker.py, run via maker_runner.py) ---
# Empty allowlist = quote nothing (safe default). Set only after manually
# confirming LIP eligibility + slow-moving price action for each series on
# the Kalshi LIP program page. Comma-separated series tickers, e.g. KXHIGH.
PE_MAKER_SERIES=
PE_MAKER_QUOTE_SIZE=100
PE_MAKER_HALF_SPREAD_CENTS=3
PE_MAKER_MIN_EDGE=0.005
PE_MAKER_REQUOTE_THRESHOLD_CENTS=2
PE_MAKER_MIN_REQUOTE_INTERVAL_S=5.0
PE_MAKER_MAX_POSITION=200
PE_MAKER_MAX_EXPOSURE=400
PE_MAKER_SKEW_CENTS_PER_100=1
PE_MAKER_PULL_BEFORE_MIN=30
PE_MAKER_PULL_AFTER_MIN=15
PE_MAKER_MAX_BOOK_STALENESS_S=30
# 1 = log intended quotes only. Flipping to 0 also requires PE_LIVE_TRADING=1
# and the dashboard arm switch (shared with the main runner's kill-switch).
PE_MAKER_DRY_RUN=1
